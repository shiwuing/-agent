# 两种模式：
# 1) 离线 Mock（默认）：无需任何变量；MockLLM + data/offline_embeddings.json
# 2) API 模式：使用你自己的 ANTHROPIC_API_KEY（对话）与 EMBEDDING_API_KEY（在线向量）
# 仓库不包含、也不会长期提供作者的 Key；未填写时自动回退离线 Mock。
ANTHROPIC_API_KEY=your_api_key_here

# 官方 Anthropic 端点留空；兼容端点可指向对应服务
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# anthropic | mock
LLM_PROVIDER=anthropic

# 默认 claude-opus-5-5；兼容端点需改成对方模型名（如 deepseek-v4-flash）
MODEL_ID=claude-opus-5-5

# 语义检索（Embedding）
# offline = 使用仓库内预计算向量（无 Key 推荐，默认）
# openai | voyage | ark = 调用对应 API；none = 纯关键词
EMBEDDING_PROVIDER=offline
EMBEDDING_API_KEY=your_embedding_key_here
# OpenAI 兼容服务可改 base_url / model
# Voyage: https://api.voyageai.com/v1 + voyage-3
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# 国内 OpenAI 兼容示例（SiliconFlow）：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=sk-...
# 低于该余弦相似度的向量命中会被丢弃；0 表示不过滤（不同模型分布不同）
# EMBEDDING_MIN_SCORE=0.4
# 火山方舟多模态接口示例：
# EMBEDDING_PROVIDER=ark
# EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# EMBEDDING_MODEL=doubao-embedding-vision-251215
# 嵌入缓存固定写在 data/.embedding_cache.json，不占用 C 盘
# 可选
# EMBEDDING_TIMEOUT=60
# EMBEDDING_BATCH_SIZE=64

# 可选：故障注入（验证工具失败路径）
# MOCK_FAIL_TOOL=search_docs
